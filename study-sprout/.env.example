# Optional OCI Generative AI connection. Copy this file to .env and fill in
# values from your hackathon tenancy. Never commit .env or private keys.
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
# Use an absolute path to your API-signing PEM key. Keep it outside public/.
OCI_PRIVATE_KEY_PATH=
# Optional passphrase for an encrypted signing key.
OCI_PRIVATE_KEY_PASSPHRASE=
# Choose an available on-demand model supporting the GENERIC chat API.
OCI_MODEL_ID=
PORT=4173
# Local only by default. Set HOST=0.0.0.0 inside a secured deployment.
HOST=127.0.0.1
